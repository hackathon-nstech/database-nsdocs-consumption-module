generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Documents {
  id            BigInt                  @id @default(autoincrement())
  id_company    Int
  access_key    String                  @db.VarChar(44)
  request_date  DateTime                @default(now()) @db.Timestamp(0)
  updated_date  DateTime                @default(now()) @updatedAt @db.Timestamp(0)

  origin_id     Int?
  origin    NsRefCodes?       @relation("OriginRelation", fields: [origin_id], references: [id])
  
  document_type_id Int?
  document_type  NsRefCodes?       @relation("DocumentTypeRelation", fields: [document_type_id], references: [id])

  status_id       Int?
  status   NsRefCodes?       @relation("StatusRelation", fields: [status_id], references: [id])

  @@unique([access_key, id_company], map: "uk_access_key_company")
  @@map("documents")
}

model Consumption {
  id               Int                     @id @default(autoincrement())
  id_company       Int
  consumption_date DateTime                @db.Date
  quantity         Int                     @default(0)
  total            Int                     @default(0)

  origin_id         Int?
  origin     NsRefCodes?       @relation("ConsumptionOriginRelation", fields: [origin_id], references: [id])

  document_type_id  Int?
  document_type NsRefCodes?     @relation("ConsumptionDocumentTypeRelation", fields: [document_type_id], references: [id])

  status_id         Int?
  status     NsRefCodes?       @relation("ConsumptionStatusRelation", fields: [status_id], references: [id])

  @@unique([id_company, consumption_date, origin_id, document_type_id, status_id], name: "uk_company_type_origin_date_status", map: "uk_company_type_origin_date_status")
  @@map("consumption")
}

model NsRefCodes {
  id          Int     @id @default(autoincrement())
  entity      String  @db.VarChar(50)
  description String  @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamp(0)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamp(0)

  @@index([entity], name: "idx_entity")
  @@unique([entity, description], name: "uk_entity_description")
  @@map("ns_ref_codes")

  // Relations of documents
  OriginRelation Documents[] @relation("OriginRelation")
  DocumentTypeRelation Documents[] @relation("DocumentTypeRelation")
  StatusRelation Documents[] @relation("StatusRelation")

  // Relations of consumption
  ConsumptionOriginRelation Consumption[] @relation("ConsumptionOriginRelation")
  ConsumptionDocumentTypeRelation Consumption[] @relation("ConsumptionDocumentTypeRelation")
  ConsumptionStatusRelation Consumption[] @relation("ConsumptionStatusRelation")
}